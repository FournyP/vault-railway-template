# Optional. `file` keeps secrets on the volume; `dev` is in-memory and loses
# everything on redeploy.
# ENV=file

# Optional. Listener port. Baked into the config at build time.
# PORT=8200

# Optional. Directory of the file backend; must be the volume's mount path.
# STORAGE_PATH=/vault/file

# Optional. Lease durations. Build-time.
# DEFAULT_LEASE_TTL=168h
# MAX_LEASE_TTL=720h

# Optional. Serve the web UI at /ui. Build-time.
# UI_ENABLED=true

# Dev mode only. Root token for `vault server -dev`; ignored otherwise.
# DEV_ROOT_TOKEN_ID=
